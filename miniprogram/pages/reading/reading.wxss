.reading-page {
  min-height: 100vh;
  padding: 52rpx 32rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(91, 63, 163, 0.08) 1px, transparent 1px),
    linear-gradient(0deg, rgba(91, 63, 163, 0.06) 1px, transparent 1px),
    #f3edf8;
  background-size: 36rpx 36rpx;
  box-sizing: border-box;
}

.reading-header {
  margin-bottom: 28rpx;
}

.reading-title {
  display: block;
  color: #26231f;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.08;
}

.reading-meta-line {
  display: block;
  margin-top: 12rpx;
  color: #70685d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.reading-notice {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(91, 63, 163, 0.2);
  border-radius: 16rpx;
  background: rgba(255, 250, 240, 0.88);
  color: #70685d;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.45;
  box-sizing: border-box;
}

.reading-content {
  line-height: 1.6;
}

.question-block {
  margin-bottom: 24rpx;
}

.section-label {
  display: block;
  margin-bottom: 10rpx;
  color: #5b3fa3;
  font-size: 22rpx;
  font-weight: 900;
}

.question-text,
.summary-text,
.reading-paragraph {
  display: block;
  color: #322c26;
  font-size: 29rpx;
  line-height: 1.62;
}

.summary-text {
  margin-bottom: 30rpx;
  font-weight: 750;
}

.drawn-section {
  margin-top: 28rpx;
}

.drawn-list {
  display: grid;
  gap: 18rpx;
}

.drawn-card {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: start;
  padding: 20rpx;
  border: 2rpx solid rgba(216, 197, 232, 0.92);
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
}

.drawn-card-image {
  width: 128rpx;
  height: 218rpx;
  border-radius: 10rpx;
  background: #d8c5e8;
  box-shadow: 0 10rpx 24rpx rgba(38, 35, 31, 0.16);
}

.drawn-card-copy {
  min-width: 0;
}

.drawn-card-title {
  display: block;
  color: #26231f;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.drawn-card-meta {
  display: block;
  margin-top: 8rpx;
  color: #70685d;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.35;
}

.drawn-card-reading {
  display: block;
  margin-top: 12rpx;
  color: #3d352e;
  font-size: 26rpx;
  line-height: 1.55;
}

.closing-section {
  margin-top: 34rpx;
}

.action-label {
  margin-top: 26rpx;
}

.empty-state {
  padding: 58rpx 24rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #26231f;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-copy {
  display: block;
  margin-top: 14rpx;
  color: #70685d;
  font-size: 25rpx;
  line-height: 1.5;
}

.return-button {
  display: flex;
  width: 100%;
  max-width: 420rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 44rpx auto 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #26231f;
  box-sizing: border-box;
  color: #fffaf0;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.return-button::after {
  border: 0;
}
