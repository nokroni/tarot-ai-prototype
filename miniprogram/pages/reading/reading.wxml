<view class="reading-page">
  <view class="reading-header">
    <text class="reading-title">{{ui.title}}</text>
    <text wx:if="{{metadataLine}}" class="reading-meta-line">{{metadataLine}}</text>
  </view>

  <view wx:if="{{notice}}" class="reading-notice">
    <text>{{notice}}</text>
  </view>

  <view wx:if="{{interpretation}}" class="reading-content">
    <view wx:if="{{question}}" class="question-block">
      <text class="section-label">{{ui.questionLabel}}</text>
      <text class="question-text">{{question}}</text>
    </view>

    <view wx:if="{{isRahdueReading}}" class="rahdue-reading-template">
      <text class="summary-text rahdue-summary-text">{{interpretation.summary}}</text>

      <view class="rahdue-canvas-panel">
        <canvas canvas-id="rahdue-wheel-canvas" id="rahdue-wheel-canvas" class="rahdue-wheel-canvas"></canvas>
        <cover-view class="rahdue-card-map">
          <block wx:for="{{rahdueCanvasSlots}}" wx:key="id">
            <cover-image
              wx:if="{{item.imageSrc}}"
              class="rahdue-map-card {{item.solidifier ? 'solidifier' : ''}}"
              src="{{item.imageSrc}}"
              style="{{item.style}}"
            ></cover-image>
            <cover-view
              wx:else
              class="rahdue-map-card rahdue-map-card-placeholder {{item.solidifier ? 'solidifier' : ''}}"
              style="{{item.style}}"
            >
              {{item.position}}
            </cover-view>
          </block>
        </cover-view>
      </view>

      <view class="section-summary-list rahdue-section-summary-list">
        <view wx:for="{{sections}}" wx:key="id" class="section-summary-item">
          <text class="section-summary-title">{{item.title}}</text>
          <text class="section-summary-copy">{{item.interpretation}}</text>
        </view>
      </view>

      <view class="drawn-section rahdue-drawn-section">
        <text class="section-label">{{ui.cardsTitle}}</text>
        <view class="rahdue-card-sections">
          <view wx:for="{{sections}}" wx:key="id" class="rahdue-card-section">
            <text class="rahdue-card-section-title">{{item.title}}</text>
            <view class="rahdue-card-grid">
              <view wx:for="{{item.cards}}" wx:for-item="card" wx:key="id" class="rahdue-card">
                <image wx:if="{{card.imageSrc}}" class="rahdue-card-image {{card.isReversed ? 'reversed' : ''}}" src="{{card.imageSrc}}" mode="aspectFill"></image>
                <text class="rahdue-card-name">{{card.name}}</text>
                <text class="rahdue-card-meta">{{card.position}} · {{card.orientationText}}</text>
                <text class="rahdue-card-reading">{{card.interpretation}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="closing-section rahdue-closing-section">
        <text class="section-label">{{ui.overallLabel}}</text>
        <text class="reading-paragraph">{{interpretation.overallMessage}}</text>
      </view>
    </view>

    <view wx:else class="standard-reading-template">
      <text class="summary-text">{{interpretation.summary}}</text>

      <view wx:if="{{sections.length}}" class="section-summary-list">
        <view wx:for="{{sections}}" wx:key="id" class="section-summary-item">
          <text class="section-summary-title">{{item.title}}</text>
          <text class="section-summary-copy">{{item.interpretation}}</text>
        </view>
      </view>

      <view class="drawn-section">
        <text class="section-label">{{ui.cardsTitle}}</text>
        <view class="drawn-list">
          <view wx:for="{{cards}}" wx:key="id" class="drawn-card">
            <image wx:if="{{item.imageSrc}}" class="drawn-card-image {{item.isReversed ? 'reversed' : ''}}" src="{{item.imageSrc}}" mode="aspectFill"></image>
            <view class="drawn-card-copy">
              <text class="drawn-card-title">{{item.position}} · {{item.name}}</text>
              <text class="drawn-card-meta">{{item.metaLine}}</text>
              <text class="drawn-card-reading">{{item.interpretation}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="closing-section">
        <text class="section-label">{{ui.overallLabel}}</text>
        <text class="reading-paragraph">{{interpretation.overallMessage}}</text>
        <view wx:if="{{showActionReminder}}">
          <text class="section-label action-label">{{ui.actionLabel}}</text>
          <text class="reading-paragraph">{{interpretation.practicalReflection}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-title">{{ui.emptyTitle}}</text>
    <text class="empty-copy">{{ui.emptyCopy}}</text>
  </view>

  <button class="return-button" bindtap="returnHome">{{ui.returnHome}}</button>
</view>
