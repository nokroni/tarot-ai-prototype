<view class="advanced-page">
  <view class="advanced-header">
    <text class="advanced-title">{{ui.title}}</text>
    <text class="advanced-copy">{{ui.copy}}</text>
  </view>

  <view class="advanced-panel">
    <text class="advanced-label">{{ui.spreadLabel}}</text>
    <view class="option-grid spread-grid">
      <button
        wx:for="{{spreads}}"
        wx:key="id"
        class="option-button {{selectedSpreadId === item.id ? 'active' : ''}} {{item.experimental ? 'experimental' : ''}}"
        data-spread-id="{{item.id}}"
        bindtap="selectSpread"
      >
        <text class="option-title">{{item.title}}</text>
        <text wx:if="{{item.warning}}" class="option-warning">{{item.warning}}</text>
      </button>
    </view>
  </view>

  <view class="advanced-panel">
    <text class="advanced-label">{{ui.readerLabel}}</text>
    <view class="option-grid reader-grid">
      <button
        wx:for="{{readers}}"
        wx:key="id"
        class="option-button {{selectedReaderId === item.id ? 'active' : ''}}"
        data-reader-id="{{item.id}}"
        bindtap="selectReader"
      >
        <text>{{item.title}}</text>
      </button>
    </view>
    <view class="reader-guide">
      <text
        wx:for="{{readers}}"
        wx:key="id"
        class="reader-guide-line {{selectedReaderId === item.id ? 'active' : ''}}"
      >
        {{item.title}}<text wx:if="{{item.warning}}">（{{item.warning}}）</text>：{{item.guide}}
      </text>
    </view>
  </view>

  <view class="spread-guide">
    <text class="advanced-label">{{ui.spreadGuideTitle}}</text>
    <view class="spread-guide-list">
      <text
        wx:for="{{spreads}}"
        wx:key="id"
        class="spread-guide-line {{selectedSpreadId === item.id ? 'active' : ''}}"
      >
        {{item.title}}：{{item.guide}}
      </text>
    </view>
  </view>

  <button class="primary-action" bindtap="applyAdvancedMode">{{ui.apply}}</button>
</view>
