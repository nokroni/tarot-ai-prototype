<view class="page">
  <view wx:if="{{!wheel.isOpen}}" class="main-flow">
  <view class="hero">
    <view>
      <text class="eyebrow">原型解读</text>
      <text class="title">AI 塔罗</text>
    </view>
    <view class="moon"></view>
  </view>

  <view class="panel question-panel">
    <text class="label">你的问题</text>
    <textarea
      class="question-input"
      auto-height="{{false}}"
      maxlength="180"
      placeholder="今天我需要理解什么？"
      placeholder-class="placeholder"
      value="{{question}}"
      bindinput="onQuestionInput"
    />
  </view>

  <view class="panel">
    <text class="label">牌阵</text>
    <view class="spread-control">
      <button
        wx:for="{{spreads}}"
        wx:key="id"
        class="spread-option {{selectedSpreadId === item.id ? 'active' : ''}}"
        data-spread-id="{{item.id}}"
        bindtap="selectSpread"
      >
        {{item.title}}
      </button>
    </view>
  </view>

  <view class="actions">
    <button class="action-button draw-button" bindtap="drawCards">
      <text class="action-icon">✦</text>
      <text>抽牌</text>
    </button>
    <button
      class="action-button interpret-button {{drawnCards.length === 0 ? 'disabled' : ''}}"
      disabled="{{drawnCards.length === 0 || isInterpreting}}"
      loading="{{isInterpreting}}"
      bindtap="interpretReading"
    >
      <text class="action-icon">✧</text>
      <text>解读</text>
    </button>
  </view>

  <view wx:if="{{drawnCards.length > 0}}" class="cards-section">
    <view class="section-heading">
      <text class="eyebrow">已抽取</text>
      <text class="section-title">{{selectedSpread.title}}</text>
    </view>

    <view class="cards-grid {{drawnCards.length === 1 ? 'single' : ''}}">
      <view wx:for="{{drawnCards}}" wx:key="id" class="card">
        <view class="position">{{item.position}}</view>
        <image
          wx:if="{{item.card.imageSrc}}"
          class="card-face {{item.orientation === 'reversed' ? 'reversed' : ''}}"
          src="{{item.card.imageSrc}}"
          mode="aspectFit"
        />
        <view wx:else class="sigil">☉</view>
        <text class="card-name">{{item.card.name}}</text>
        <text class="orientation {{item.orientation === 'reversed' ? 'reversed' : ''}}">{{item.orientationLabel}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="message error">
    {{errorMessage}}
  </view>

  <view wx:if="{{interpretation}}" class="reading">
    <view class="reading-heading">
      <text class="section-title">解读</text>
      <text class="source-pill">{{interpretation.sourceLabel}}</text>
    </view>
    <text class="reading-text">{{interpretation.summary}}</text>

    <view class="reading-cards">
      <view wx:for="{{interpretation.cards}}" wx:key="id" class="reading-card">
        <text class="reading-card-title">{{item.position}} · {{item.name}}</text>
        <text class="reading-meta">{{item.orientationText}}</text>
        <text class="reading-text">{{item.interpretation}}</text>
      </view>
    </view>

    <text class="reading-label">整体讯息</text>
    <text class="reading-text">{{interpretation.overallMessage}}</text>
    <text class="reading-label">行动提醒</text>
    <text class="reading-text">{{interpretation.practicalReflection}}</text>
    <text class="reading-caveat">{{interpretation.caveat}}</text>
  </view>

  <view class="note">
    <text>塔罗解读仅供反思与娱乐，不构成专业建议或确定预言。牌面由应用内随机抽取后再进行解读。</text>
  </view>

  <view class="provider-footer">
    <text class="provider-status">{{oauthStatus}}</text>
    <text class="provider-build">{{buildLabel}}</text>
  </view>
  </view>

  <view wx:if="{{wheel.isOpen}}" class="wheel-overlay" catchtouchmove="noopTouchMove">
    <view class="wheel-status">
      <text class="wheel-eyebrow">{{selectedSpread.title}}</text>
      <text class="wheel-title">抽取第 {{wheel.currentDrawNumber}} / {{wheel.requiredCount}} 张</text>
    </view>

    <view
      class="wheel-stage"
      bindtouchstart="onWheelTouchStart"
      bindtouchmove="onWheelTouchMove"
      bindtouchend="onWheelTouchEnd"
      bindtouchcancel="onWheelTouchEnd"
    >
      <view class="wheel-ring">
        <view
          wx:for="{{wheelCards}}"
          wx:key="id"
          class="wheel-card-slot {{item.visible ? 'visible' : ''}} {{index === wheel.activeIndex ? 'active' : ''}} {{index === wheel.selectedIndex ? 'popped' : ''}} {{item.drawn ? 'drawn' : ''}}"
          style="{{item.style}}"
        >
          <image class="wheel-card-back" src="{{wheel.cardBackSrc}}" mode="aspectFit" />
        </view>
      </view>

      <view class="wheel-focus {{wheel.selectedIndex !== -1 ? 'popped' : ''}} {{wheel.phase === 'revealing' ? 'revealing' : ''}}" bindtap="onWheelFocusTap">
        <image
          wx:if="{{wheel.phase === 'revealing' && wheel.revealedCard}}"
          class="wheel-focus-face {{wheel.revealedCard.orientation === 'reversed' ? 'reversed' : ''}}"
          src="{{wheel.revealedCard.card.imageSrc}}"
          mode="aspectFit"
        />
        <image wx:else class="wheel-focus-back" src="{{wheel.cardBackSrc}}" mode="aspectFit" />
      </view>
    </view>

    <view class="wheel-copy" bindtap="onWheelFocusTap">
      <text wx:if="{{wheel.phase === 'popped'}}">再次轻触，抽出这张牌</text>
      <text wx:elif="{{wheel.phase === 'revealing'}}">{{wheel.revealedCard.position}} · {{wheel.revealedCard.card.name}}</text>
      <text wx:else>滑动轮盘，轻触右下牌背</text>
    </view>
  </view>
</view>
