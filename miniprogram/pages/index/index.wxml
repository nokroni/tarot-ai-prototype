<view class="page {{wheel.isOpen ? 'page-wheel-active' : ''}}">
  <view wx:if="{{!assets.ready}}" class="asset-gate">
    <view class="asset-gate-mark">✦</view>
    <text class="asset-gate-title">{{ui.assetGateTitle}}</text>
    <text class="asset-gate-copy">{{assets.message}}</text>
    <view class="asset-progress">
      <view class="asset-progress-fill" style="width: {{assets.progress}}%;"></view>
    </view>
    <text class="asset-gate-count">{{assets.loaded}}/{{assets.total}}</text>
    <button wx:if="{{assets.error}}" class="asset-retry" bindtap="retryLoadAssets">{{ui.assetRetry}}</button>
  </view>

  <view wx:else class="main-flow">
    <view class="main-header">
      <text class="app-title">{{ui.title}}</text>
      <view class="hero-tools compact">
        <view class="language-toggle" role="group">
          <view
            wx:for="{{languages}}"
            wx:key="id"
            class="language-option {{language === item.id ? 'active' : ''}}"
            data-language="{{item.id}}"
            bindtap="selectLanguage"
            role="button"
          >
            {{item.title}}
          </view>
        </view>
        <view
          class="music-toggle {{music.enabled ? 'active' : 'muted'}}"
          bindtap="toggleMusic"
          aria-label="{{music.enabled ? ui.musicOnLabel : ui.musicOffLabel}}"
          role="button"
        >
          <text class="music-toggle-note">♪</text>
        </view>
      </view>
    </view>

    <view class="question-dock">
      <view class="mode-row">
        <text class="mode-summary">{{modeSummary}}</text>
        <button class="mode-link" bindtap="goAdvancedMode">{{ui.modeChange}}</button>
      </view>
      <view class="question-submit-row">
        <textarea
          class="question-input compact-question-input"
          auto-height="{{false}}"
          maxlength="180"
          placeholder="{{ui.questionPlaceholder}}"
          placeholder-class="placeholder"
          value="{{question}}"
          bindinput="onQuestionInput"
        />
        <button class="submit-button" bindtap="drawCards" loading="{{wheel.phase === 'drawing'}}">
          {{ui.submitButton}}
        </button>
      </view>
    </view>

    <view class="deck-stage {{wheel.isOpen ? 'deck-stage-wheel' : ''}}">
      <view class="wheel-overlay {{wheel.isOpen ? 'wheel-overlay-open' : 'wheel-overlay-idle'}} wheel-motion-{{wheel.motion}}">
        <view wx:if="{{wheel.isOpen}}" class="wheel-aperture-ring"></view>
        <view wx:if="{{wheel.isOpen}}" class="wheel-status">
          <text class="wheel-eyebrow">{{selectedSpread.title}}</text>
          <text class="wheel-title">{{ui.wheelDrawPrefix}}{{wheel.currentDrawNumber}}{{ui.wheelDrawMiddle}}{{wheel.requiredCount}}{{ui.wheelDrawSuffix}}{{wheel.currentDrawPosition}}</text>
        </view>

        <view class="wheel-stage">
          <scroll-view
            class="wheel-scroll"
            scroll-x="{{true}}"
            enhanced="{{true}}"
            enable-flex="{{true}}"
            bounces="{{true}}"
            fast-deceleration="{{false}}"
            show-scrollbar="{{false}}"
            scroll-with-animation="{{wheel.scrollWithAnimation}}"
            scroll-into-view="{{wheel.scrollIntoView}}"
            bindscroll="onWheelNativeScroll"
          >
            <view class="wheel-track">
              <view id="wheel-scroll-home" class="wheel-spacer wheel-spacer-start"></view>
              <view
                wx:for="{{wheelCards}}"
                wx:key="id"
                id="wheel-slot-{{index}}"
                class="wheel-card-slot {{wheel.isOpen && index === wheel.activeIndex ? 'active' : ''}} {{wheel.isOpen && index === wheel.selectedIndex ? 'popped' : ''}} {{item.drawn ? 'drawn' : ''}}"
                style="{{item.slotStyle}}"
                data-index="{{index}}"
                bindtap="onWheelCardTap"
              >
                <view class="wheel-card-arc" style="{{item.arcStyle}}">
                  <view class="wheel-card-shell">
                    <image class="wheel-card-back" src="{{wheel.cardBackSrc}}" mode="aspectFill" />
                  </view>
                </view>
              </view>
              <view class="wheel-spacer wheel-spacer-end"></view>
            </view>
          </scroll-view>
        </view>

        <view wx:if="{{wheel.flightCard}}" class="wheel-flight-card">
          <view class="wheel-flight-card-plane">
            <view class="wheel-flight-card-draw">
              <view class="wheel-flight-card-inner">
                <view class="wheel-flight-face wheel-flight-back">
                  <image class="wheel-card-back" src="{{wheel.cardBackSrc}}" mode="aspectFill" />
                </view>
                <view class="wheel-flight-face wheel-flight-front">
                  <image
                    wx:if="{{wheel.flightCard.card.imageSrc}}"
                    class="wheel-card-face {{wheel.flightCard.orientation === 'reversed' ? 'reversed' : ''}}"
                    src="{{wheel.flightCard.card.imageSrc}}"
                    mode="aspectFit"
                  />
                  <view wx:else class="wheel-flight-sigil">☉</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{wheel.isOpen}}" class="wheel-copy">
          <text wx:if="{{wheel.phase === 'popped'}}">{{ui.wheelTapAgain}}</text>
          <text wx:elif="{{wheel.phase === 'drawing' && wheel.flightCard}}">{{wheel.flightCard.position}} · {{wheel.flightCard.card.name}}</text>
          <text wx:elif="{{wheel.phase === 'closing'}}">{{ui.wheelComplete}}</text>
          <text wx:else>{{ui.wheelHint}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="message error">
      {{errorMessage}}
    </view>

    <view wx:if="{{interpretation}}" class="reading">
      <view class="reading-heading">
        <text class="section-title">{{ui.readingTitle}}</text>
      </view>
      <text class="reading-text">{{interpretation.summary}}</text>

      <view class="reading-cards">
        <view wx:for="{{interpretation.cards}}" wx:key="id" class="reading-card">
          <text class="reading-card-title">{{item.position}} · {{item.name}}</text>
          <text class="reading-meta">{{item.orientationText}}</text>
          <text class="reading-text">{{item.interpretation}}</text>
        </view>
      </view>

      <text class="reading-label">{{ui.overallLabel}}</text>
      <text class="reading-text">{{interpretation.overallMessage}}</text>
      <text class="reading-label">{{ui.actionLabel}}</text>
      <text class="reading-text">{{interpretation.practicalReflection}}</text>
    </view>

    <view class="note">
      <text>{{ui.safetyNote}}</text>
    </view>

    <view class="provider-footer">
      <text class="provider-status">{{oauthStatus}}</text>
      <text class="provider-build">{{buildLabel}}</text>
    </view>
  </view>
</view>
