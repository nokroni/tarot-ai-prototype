<view class="page">
  <view class="hero">
    <view>
      <text class="eyebrow">Prototype Reading</text>
      <text class="title">AI Tarot</text>
    </view>
    <view class="moon"></view>
  </view>

  <view class="panel question-panel">
    <text class="label">Your question</text>
    <textarea
      class="question-input"
      auto-height="{{false}}"
      maxlength="180"
      placeholder="What do I need to understand today?"
      placeholder-class="placeholder"
      value="{{question}}"
      bindinput="onQuestionInput"
    />
  </view>

  <view class="oauth-panel">
    <view>
      <text class="label compact">AI Backend</text>
      <text class="oauth-status">{{oauthStatus}}</text>
      <text class="backend-status">{{buildLabel}} · {{backendStatus}}</text>
    </view>
    <view class="oauth-actions">
      <button wx:if="{{!oauthSession}}" class="oauth-button" loading="{{isConnecting}}" bindtap="connectChatGPT">
        Connect
      </button>
      <button wx:else class="oauth-button secondary" bindtap="disconnectChatGPT">
        Disconnect
      </button>
    </view>
  </view>

  <view class="panel">
    <text class="label">Spread</text>
    <view class="spread-control">
      <button
        wx:for="{{spreads}}"
        wx:key="id"
        class="spread-option {{selectedSpreadId === item.id ? 'active' : ''}}"
        data-spread-id="{{item.id}}"
        bindtap="selectSpread"
      >
        {{item.title}}
      </button>
    </view>
  </view>

  <view class="actions">
    <button class="action-button draw-button" bindtap="drawCards">
      <text class="action-icon">✦</text>
      <text>Draw Cards</text>
    </button>
    <button
      class="action-button interpret-button {{drawnCards.length === 0 ? 'disabled' : ''}}"
      disabled="{{drawnCards.length === 0 || isInterpreting}}"
      loading="{{isInterpreting}}"
      bindtap="interpretReading"
    >
      <text class="action-icon">✧</text>
      <text>Interpret</text>
    </button>
  </view>

  <view wx:if="{{drawnCards.length > 0}}" class="cards-section">
    <view class="section-heading">
      <text class="eyebrow">Drawn Locally</text>
      <text class="section-title">{{selectedSpread.title}}</text>
    </view>

    <view class="cards-grid {{drawnCards.length === 1 ? 'single' : ''}}">
      <view wx:for="{{drawnCards}}" wx:key="id" class="card">
        <view class="position">{{item.position}}</view>
        <view class="sigil">☉</view>
        <text class="card-name">{{item.card.name}}</text>
        <text class="orientation">{{item.orientation}}</text>
        <view class="keywords">
          <text wx:for="{{item.keywords}}" wx:for-item="keyword" wx:key="*this" class="keyword">{{keyword}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="message error">
    {{errorMessage}}
  </view>

  <view wx:if="{{interpretation}}" class="reading">
    <view class="reading-heading">
      <text class="section-title">Reading</text>
      <text class="source-pill">{{interpretation.sourceLabel}}</text>
    </view>
    <text class="reading-text">{{interpretation.summary}}</text>

    <view class="reading-cards">
      <view wx:for="{{interpretation.cards}}" wx:key="id" class="reading-card">
        <text class="reading-card-title">{{item.position}} · {{item.name}}</text>
        <text class="reading-meta">{{item.orientation}} · {{item.keywordsText}}</text>
        <text class="reading-text">{{item.interpretation}}</text>
      </view>
    </view>

    <text class="reading-label">Overall message</text>
    <text class="reading-text">{{interpretation.overallMessage}}</text>
    <text class="reading-label">Practical reflection</text>
    <text class="reading-text">{{interpretation.practicalReflection}}</text>
    <text class="reading-label">Journal prompt</text>
    <text class="reading-text">{{interpretation.journalQuestion}}</text>
    <text class="reading-caveat">{{interpretation.caveat}}</text>
  </view>

  <view class="note">
    <text>Tarot readings are for reflection and entertainment, not professional advice or certain predictions. Cards are drawn inside the app before interpretation.</text>
  </view>
</view>
