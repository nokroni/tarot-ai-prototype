.page {
  min-height: 100vh;
  padding: 52rpx 32rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(47, 55, 111, 0.06) 1px, transparent 1px),
    linear-gradient(0deg, rgba(47, 55, 111, 0.05) 1px, transparent 1px),
    #f5f0e6;
  background-size: 36rpx 36rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.eyebrow,
.label {
  display: block;
  color: #a34231;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #26231f;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.96;
}

.moon {
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, transparent 0 23rpx, #2f376f 24rpx 29rpx, transparent 30rpx);
}

.panel {
  margin-bottom: 28rpx;
}

.label {
  margin: 0 0 14rpx 36rpx;
  color: #70685d;
}

.label.compact {
  margin: 0 0 8rpx;
}

.question-input {
  width: 100%;
  height: 178rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #dccfb9;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
  color: #26231f;
  font-size: 32rpx;
  line-height: 1.42;
}

.placeholder {
  color: #9c958c;
}

.spread-control {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border: 2rpx solid #dccfb9;
  border-radius: 18rpx;
  background: #f1e6d0;
}

.spread-option {
  flex: 1;
  min-height: 76rpx;
  border-radius: 14rpx;
  color: #70685d;
  font-size: 30rpx;
  font-weight: 800;
}

.spread-option.active {
  background: #fffaf0;
  color: #26231f;
  box-shadow: 0 8rpx 24rpx rgba(64, 45, 24, 0.12);
}

.actions {
  display: flex;
  gap: 18rpx;
  margin: 36rpx 0;
}

.action-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 850;
}

.action-icon {
  font-size: 36rpx;
}

.draw-button {
  background: #17695f;
  color: #fffaf0;
}

.interpret-button {
  background: #a34231;
  color: #fffaf0;
}

.interpret-button.disabled {
  background: #d5cabe;
  color: #81786f;
}

.cards-section {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  color: #26231f;
  font-size: 38rpx;
  font-weight: 900;
}

.cards-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cards-grid.single .card {
  width: 100%;
  min-width: 0;
}

.card {
  width: 100%;
  min-height: 0;
  padding: 22rpx 24rpx 24rpx;
  border: 2rpx solid #bfae91;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, transparent 0 25%, rgba(199, 139, 46, 0.18) 25% 28%, transparent 28%),
    #fff6df;
  box-sizing: border-box;
  text-align: center;
}

.card-face {
  display: block;
  width: 58%;
  height: 630rpx;
  margin: 18rpx auto 20rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 12rpx;
  background: #171311;
  box-shadow: 0 10rpx 18rpx rgba(38, 35, 31, 0.16);
}

.card-face.reversed {
  transform: rotate(180deg);
}

.position {
  color: #a34231;
  font-size: 20rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.sigil {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 36rpx auto 22rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 50%;
  background: #fffaf0;
  color: #2f376f;
  font-size: 34rpx;
}

.card-name {
  display: block;
  min-height: 42rpx;
  color: #26231f;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.orientation {
  display: block;
  margin-top: 10rpx;
  color: #70685d;
  font-size: 22rpx;
  font-weight: 800;
  text-transform: capitalize;
}

.orientation.reversed {
  color: #a34231;
}

.message,
.reading,
.note {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #dccfb9;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
}

.message.error {
  border-color: rgba(163, 66, 49, 0.28);
  background: #fff0ea;
  color: #7a2e24;
  font-size: 28rpx;
  font-weight: 800;
}

.reading {
  line-height: 1.6;
}

.reading-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.source-pill {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #eef7f2;
  color: #17695f;
  font-size: 20rpx;
  font-weight: 850;
}

.reading-text {
  display: block;
  margin-top: 14rpx;
  color: #3d352e;
  font-size: 28rpx;
  line-height: 1.58;
}

.reading-cards {
  margin-top: 20rpx;
}

.reading-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #dccfb9;
}

.reading-card-title,
.reading-label {
  display: block;
  margin-top: 24rpx;
  color: #17695f;
  font-size: 24rpx;
  font-weight: 900;
}

.reading-meta,
.reading-caveat {
  display: block;
  margin-top: 8rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.45;
}

.reading-caveat {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #dccfb9;
}

.note {
  color: #70685d;
  font-size: 24rpx;
  line-height: 1.55;
}

.provider-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.4;
}

.provider-status {
  color: #17695f;
  font-weight: 850;
}

.provider-build {
  color: #9c958c;
}

.main-flow {
  min-height: 100vh;
}

.wheel-overlay {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 16%, rgba(199, 139, 46, 0.2), transparent 24%),
    radial-gradient(circle at 50% 64%, rgba(23, 105, 95, 0.42), transparent 42%),
    #143f3f;
  color: #fffaf0;
}

.wheel-status {
  position: absolute;
  top: 52rpx;
  right: 36rpx;
  left: 36rpx;
  z-index: 5;
  text-align: center;
}

.wheel-eyebrow {
  display: block;
  color: #d9aa54;
  font-size: 22rpx;
  font-weight: 900;
}

.wheel-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.wheel-stage {
  position: absolute;
  top: 156rpx;
  right: 0;
  bottom: 142rpx;
  left: 0;
  overflow: hidden;
  touch-action: none;
}

.wheel-marker {
  position: absolute;
  top: 440rpx;
  left: 20%;
  z-index: 4;
  width: 118rpx;
  height: 118rpx;
  border-top: 4rpx solid #d9aa54;
  border-left: 4rpx solid #d9aa54;
  transform: translateX(-50%) rotate(45deg);
  opacity: 0.8;
}

.wheel-ring {
  position: absolute;
  right: -940rpx;
  bottom: -940rpx;
  width: 1880rpx;
  height: 1880rpx;
  border: 2rpx solid rgba(217, 170, 84, 0.28);
  border-radius: 50%;
  transform-origin: center center;
  transition: transform 120ms ease-out;
}

.wheel-ring::before,
.wheel-ring::after {
  position: absolute;
  content: "";
  border: 1rpx solid rgba(255, 250, 240, 0.15);
  border-radius: 50%;
}

.wheel-ring::before {
  inset: 120rpx;
}

.wheel-ring::after {
  inset: 242rpx;
}

.wheel-card-slot {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  width: 88rpx;
  height: 154rpx;
  opacity: 0.86;
  transition: opacity 160ms ease, filter 160ms ease;
}

.wheel-card-slot.active {
  z-index: 3;
  opacity: 1;
  filter: drop-shadow(0 0 14rpx rgba(217, 170, 84, 0.8));
}

.wheel-card-slot.drawn {
  opacity: 0.2;
  filter: grayscale(1);
}

.wheel-card-slot.popped {
  opacity: 0.35;
}

.wheel-card-back,
.wheel-focus-back,
.wheel-focus-face {
  display: block;
  width: 100%;
  height: 100%;
}

.wheel-focus {
  position: absolute;
  top: 362rpx;
  left: 19%;
  z-index: 6;
  width: 192rpx;
  height: 336rpx;
  transform: translateX(-50%);
  transition: top 220ms ease, transform 220ms ease, filter 220ms ease;
  filter: drop-shadow(0 18rpx 28rpx rgba(0, 0, 0, 0.28));
}

.wheel-focus.popped {
  top: 286rpx;
  left: 16%;
  transform: translateX(-50%) scale(1.1);
  filter: drop-shadow(0 28rpx 42rpx rgba(0, 0, 0, 0.34));
}

.wheel-focus.revealing {
  top: 248rpx;
  left: 16%;
  transform: translateX(-50%) scale(1.18);
}

.wheel-focus-face {
  border-radius: 12rpx;
}

.wheel-focus-face.reversed {
  transform: rotate(180deg);
}

.wheel-copy {
  position: absolute;
  right: 36rpx;
  bottom: 48rpx;
  left: 36rpx;
  z-index: 7;
  min-height: 56rpx;
  color: #f3ddaa;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: center;
}
