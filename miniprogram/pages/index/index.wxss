.page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 52rpx 32rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(91, 63, 163, 0.08) 1px, transparent 1px),
    linear-gradient(0deg, rgba(91, 63, 163, 0.06) 1px, transparent 1px),
    #f3edf8;
  background-size: 36rpx 36rpx;
  box-sizing: border-box;
  transition: background-color 680ms ease;
}

.page::before {
  position: fixed;
  inset: 0;
  z-index: 0;
  content: "";
  background:
    radial-gradient(circle at 50% 44%, rgba(243, 221, 170, 0.18), transparent 21%),
    radial-gradient(circle at 50% 56%, rgba(91, 63, 163, 0.58), transparent 46%),
    #241047;
  opacity: 0;
  pointer-events: none;
  transition: opacity 820ms cubic-bezier(0.2, 0.78, 0.18, 1);
}

.page-wheel-active::before {
  opacity: 1;
}

.asset-gate {
  position: relative;
  z-index: 1;
  display: flex;
  min-height: calc(100vh - 124rpx);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18rpx;
  text-align: center;
}

.asset-gate-mark {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(91, 63, 163, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.76);
  color: #a34231;
  font-size: 40rpx;
  font-weight: 900;
}

.asset-gate-title {
  color: #33283f;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.asset-gate-copy,
.asset-gate-count {
  color: #8f887f;
  font-size: 22rpx;
  font-weight: 700;
}

.asset-progress {
  width: 520rpx;
  max-width: 72vw;
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(91, 63, 163, 0.14);
}

.asset-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #a34231;
  transition: width 180ms ease;
}

.asset-retry {
  min-width: 168rpx;
  height: 58rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #5b3fa3;
  color: #fffaf0;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.hero-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.language-toggle {
  display: flex;
  width: 178rpx;
  height: 52rpx;
  flex: 0 0 178rpx;
  align-items: center;
  gap: 4rpx;
  padding: 5rpx;
  border: 2rpx solid rgba(91, 63, 163, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.72);
  box-sizing: border-box;
  overflow: hidden;
}

.language-option {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: transparent;
  color: #70685d;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.language-option.active {
  background: #5b3fa3;
  color: #fffaf0;
}

.music-toggle {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  min-height: 0;
  min-width: 0;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 2rpx solid rgba(199, 139, 46, 0.72);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.72);
  box-sizing: border-box;
  color: #5b3fa3;
  line-height: 1;
  overflow: hidden;
}

.music-toggle::after {
  border: 0;
}

.music-toggle-note {
  font-size: 25rpx;
  font-weight: 900;
  transform: translateY(-1rpx);
}

.music-toggle.muted {
  opacity: 0.48;
}

.music-toggle.muted::before {
  position: absolute;
  top: 9rpx;
  left: 23rpx;
  width: 2rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #a34231;
  content: "";
  transform: rotate(42deg);
  transform-origin: center;
}

.question-input {
  width: 100%;
  height: 178rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
  color: #26231f;
  font-size: 32rpx;
  line-height: 1.42;
}

.placeholder {
  color: #9c958c;
}

.section-title {
  display: block;
  color: #26231f;
  font-size: 38rpx;
  font-weight: 900;
}

.message,
.reading,
.note {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
}

.message.error {
  border-color: rgba(163, 66, 49, 0.28);
  background: #fff0ea;
  color: #7a2e24;
  font-size: 28rpx;
  font-weight: 800;
}

.reading {
  line-height: 1.6;
}

.reading-heading {
  display: flex;
  align-items: center;
}

.reading-text {
  display: block;
  margin-top: 14rpx;
  color: #3d352e;
  font-size: 28rpx;
  line-height: 1.58;
}

.reading-cards {
  margin-top: 20rpx;
}

.reading-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #d8c5e8;
}

.reading-card-title,
.reading-label {
  display: block;
  margin-top: 24rpx;
  color: #5b3fa3;
  font-size: 24rpx;
  font-weight: 900;
}

.reading-meta {
  display: block;
  margin-top: 8rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.45;
}

.note {
  color: #70685d;
  font-size: 24rpx;
  line-height: 1.55;
}

.provider-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.4;
}

.provider-status {
  color: #5b3fa3;
  font-weight: 850;
}

.provider-build {
  color: #9c958c;
}

.main-flow {
  position: relative;
  z-index: 1;
  min-height: auto;
  transition: none;
}

.wheel-overlay {
  position: relative;
  inset: auto;
  width: 100%;
  min-height: 700rpx;
  overflow: hidden;
  -webkit-clip-path: none;
  clip-path: none;
  background: transparent;
  color: #fffaf0;
  animation: none;
  will-change: auto;
}

.wheel-overlay::before {
  position: absolute;
  inset: -120rpx -80rpx;
  z-index: 0;
  content: "";
  background:
    radial-gradient(circle at 50% 54%, rgba(255, 250, 240, 0.15), transparent 20%),
    radial-gradient(circle at 50% 56%, transparent 0 34%, rgba(20, 9, 39, 0.22) 58%, rgba(20, 9, 39, 0.5) 100%);
  pointer-events: none;
}

.wheel-aperture-ring {
  position: absolute;
  top: 54%;
  left: 50%;
  z-index: 1;
  width: 180rpx;
  height: 180rpx;
  border: 2rpx solid rgba(243, 221, 170, 0.62);
  border-radius: 50%;
  box-shadow:
    0 0 42rpx rgba(243, 221, 170, 0.32),
    inset 0 0 32rpx rgba(243, 221, 170, 0.18);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(0.24);
  animation: wheel-aperture-ring-open 1120ms cubic-bezier(0.12, 0.78, 0.16, 1) forwards;
}

.wheel-motion-closing {
  pointer-events: none;
  animation: none;
}

.wheel-motion-closing .wheel-aperture-ring {
  animation: wheel-aperture-ring-close 660ms cubic-bezier(0.3, 0, 0.2, 1) forwards;
}

.wheel-status {
  position: absolute;
  top: 18rpx;
  right: 36rpx;
  left: 36rpx;
  z-index: 5;
  text-align: center;
  animation: wheel-content-enter 840ms cubic-bezier(0.18, 0.82, 0.16, 1) 120ms both;
}

.wheel-eyebrow {
  display: block;
  color: #d9aa54;
  font-size: 22rpx;
  font-weight: 900;
}

.wheel-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.wheel-stage {
  position: absolute;
  top: 80rpx;
  right: 0;
  bottom: 92rpx;
  left: 0;
  z-index: 2;
  overflow: hidden;
  animation: wheel-content-enter 880ms cubic-bezier(0.18, 0.82, 0.16, 1) 120ms both;
}

.wheel-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  white-space: nowrap;
}

.wheel-motion-stack .wheel-scroll,
.wheel-motion-spreading .wheel-scroll,
.wheel-motion-closing .wheel-scroll {
  pointer-events: none;
}

.wheel-track {
  display: inline-flex;
  align-items: center;
  height: 100%;
  padding-top: 0;
  box-sizing: border-box;
}

.wheel-spacer {
  flex: 0 0 auto;
  height: 1rpx;
}

.wheel-spacer-start {
  width: 281rpx;
}

.wheel-spacer-end {
  width: 650rpx;
}

.wheel-card-slot {
  position: relative;
  z-index: 1;
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 330rpx;
  margin-right: -156rpx;
  opacity: 1;
  transition:
    filter 180ms ease,
    opacity 180ms ease;
}

.wheel-card-slot.active {
  z-index: 20;
  filter: drop-shadow(0 22rpx 30rpx rgba(0, 0, 0, 0.42)) drop-shadow(0 0 24rpx rgba(243, 221, 170, 0.88));
}

.wheel-card-slot.drawn {
  opacity: 0.18;
  filter: grayscale(1);
}

.wheel-card-slot.popped {
  z-index: 24;
  opacity: 1;
}

.wheel-card-arc {
  width: 100%;
  height: 100%;
  transform-origin: center 760rpx;
  transition: transform 120ms linear, opacity 120ms linear;
  will-change: transform, opacity;
}

.wheel-motion-stack .wheel-card-arc {
  transition: none;
}

.wheel-motion-spreading .wheel-card-arc {
  transition:
    transform 1120ms cubic-bezier(0.18, 0.82, 0.22, 1),
    opacity 720ms ease;
}

.wheel-motion-closing .wheel-card-arc {
  transition:
    transform 520ms cubic-bezier(0.28, 0, 0.18, 1),
    opacity 300ms ease;
}

.wheel-motion-closing .wheel-stage,
.wheel-motion-closing .wheel-status,
.wheel-motion-closing .wheel-copy {
  animation: wheel-content-exit 540ms cubic-bezier(0.3, 0, 0.2, 1) forwards;
}

.wheel-card-shell {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 14rpx;
  transition:
    transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
    filter 220ms ease;
}

.wheel-card-slot.active .wheel-card-shell {
  box-shadow: 0 0 0 3rpx rgba(243, 221, 170, 0.94);
}

.wheel-card-slot.popped .wheel-card-shell {
  transform: translateY(-26rpx) scale(1.06);
}

.wheel-card-back,
.wheel-card-face {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.wheel-card-face {
  border-radius: 12rpx;
}

.wheel-card-face.reversed {
  transform: rotate(180deg);
}

.wheel-flight-card {
  position: absolute;
  top: 154rpx;
  left: 38rpx;
  z-index: 6;
  width: 188rpx;
  height: 330rpx;
  perspective: 1180rpx;
  pointer-events: none;
}

.wheel-flight-card-plane {
  width: 100%;
  height: 100%;
  transform-origin: center;
  animation: wheel-card-pop-move 820ms cubic-bezier(0.08, 0.72, 0.12, 1) forwards;
}

.wheel-flight-card-draw {
  width: 100%;
  height: 100%;
  transform-origin: center;
}

.wheel-flight-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
}

.wheel-flight-face {
  position: absolute;
  inset: 0;
}

.wheel-flight-back {
  opacity: 1;
  animation: wheel-card-draw-back-flip 300ms cubic-bezier(0.22, 0.72, 0.2, 1) 820ms forwards;
  backface-visibility: hidden;
}

.wheel-flight-front {
  animation: wheel-card-draw-front-flip 300ms cubic-bezier(0.22, 0.72, 0.2, 1) 820ms forwards;
  backface-visibility: hidden;
  transform: rotateX(180deg);
}

.wheel-flight-sigil {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(243, 221, 170, 0.72);
  border-radius: 14rpx;
  background: #171311;
  box-sizing: border-box;
  color: #f3ddaa;
  font-size: 64rpx;
}

@keyframes wheel-card-pop-move {
  0% {
    opacity: 1;
    transform: translate(245rpx, 360rpx) rotate(-4deg) scale(1.04);
  }

  12% {
    opacity: 1;
    transform: translate(215rpx, 316rpx) rotate(-4deg) scale(1.14);
  }

  100% {
    opacity: 1;
    transform: translate(0, 0) rotate(0deg) scale(0.78);
  }
}

@keyframes wheel-card-draw-back-flip {
  0% {
    transform: rotateX(0deg);
  }

  100% {
    transform: rotateX(180deg);
  }
}

@keyframes wheel-card-draw-front-flip {
  0% {
    transform: rotateX(180deg);
  }

  100% {
    transform: rotateX(360deg);
  }
}

.wheel-copy {
  position: absolute;
  right: 36rpx;
  bottom: 20rpx;
  left: 36rpx;
  z-index: 7;
  min-height: 56rpx;
  color: #f3ddaa;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: center;
  animation: wheel-content-enter 840ms cubic-bezier(0.18, 0.82, 0.16, 1) 160ms both;
}

@keyframes wheel-aperture-ring-open {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.18);
  }

  32% {
    opacity: 0.82;
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(6.2);
  }
}

@keyframes wheel-aperture-ring-close {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(6.2);
  }

  38% {
    opacity: 0.7;
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.2);
  }
}

@keyframes wheel-content-enter {
  0% {
    opacity: 0;
    transform: scale(0.975);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes wheel-content-exit {
  0% {
    opacity: 1;
    transform: scale(1);
  }

  100% {
    opacity: 0;
    transform: scale(0.965);
  }
}

/* Compact single-card home layout */
.main-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.app-title {
  display: block;
  min-width: 0;
  color: #26231f;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.05;
}

.page-wheel-active .app-title {
  color: #fffaf0;
}

.hero-tools.compact {
  flex: 0 0 auto;
}

.question-dock {
  padding: 20rpx;
  border: 2rpx solid rgba(216, 197, 232, 0.82);
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.92);
  box-shadow: 0 12rpx 34rpx rgba(64, 45, 24, 0.08);
  box-sizing: border-box;
}

.mode-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.mode-summary {
  display: block;
  min-width: 0;
  color: #70685d;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: color 420ms ease;
}

.mode-link {
  display: flex;
  width: 100%;
  min-width: 212rpx;
  max-width: 100%;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid rgba(91, 63, 163, 0.24);
  border-radius: 999rpx;
  background: rgba(234, 223, 247, 0.86);
  color: #5b3fa3;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
}

.mode-link::after,
.submit-button::after {
  border: 0;
}

.question-submit-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(96rpx, 116rpx);
  gap: 14rpx;
  align-items: stretch;
}

.compact-question-input {
  height: 104rpx;
  min-height: 104rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.32;
}

.submit-button {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #5b3fa3;
  box-sizing: border-box;
  color: #fffaf0;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
}

.deck-stage {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 520rpx;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.deck-stage-wheel {
  min-height: 700rpx;
  align-items: stretch;
}

.idle-deck {
  position: relative;
  width: 230rpx;
  height: 420rpx;
}

.idle-card {
  position: absolute;
  top: 22rpx;
  left: 50%;
  width: 188rpx;
  height: 330rpx;
  overflow: hidden;
  border-radius: 14rpx;
  box-shadow: 0 18rpx 34rpx rgba(38, 35, 31, 0.18);
  transform-origin: center 86%;
}

.idle-card-1 {
  z-index: 3;
  transform: translateX(-50%) rotate(0deg);
}

.idle-card-2 {
  z-index: 2;
  transform: translateX(-50%) rotate(-7deg) translateY(12rpx);
}

.idle-card-3 {
  z-index: 1;
  transform: translateX(-50%) rotate(7deg) translateY(14rpx);
}

.idle-card-back {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.idle-deck-caption {
  position: absolute;
  right: -80rpx;
  bottom: 0;
  left: -80rpx;
  color: #70685d;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.35;
  text-align: center;
}

.page-wheel-active .idle-deck-caption {
  color: #f3ddaa;
}
