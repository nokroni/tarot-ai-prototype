.page {
  min-height: 100vh;
  padding: 52rpx 32rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(91, 63, 163, 0.08) 1px, transparent 1px),
    linear-gradient(0deg, rgba(91, 63, 163, 0.06) 1px, transparent 1px),
    #f3edf8;
  background-size: 36rpx 36rpx;
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.eyebrow,
.label {
  display: block;
  color: #a34231;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #26231f;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.96;
}

.moon {
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, transparent 0 23rpx, #5b3fa3 24rpx 29rpx, transparent 30rpx);
}

.panel {
  margin-bottom: 28rpx;
}

.label {
  margin: 0 0 14rpx 36rpx;
  color: #70685d;
}

.label.compact {
  margin: 0 0 8rpx;
}

.question-input {
  width: 100%;
  height: 178rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
  color: #26231f;
  font-size: 32rpx;
  line-height: 1.42;
}

.placeholder {
  color: #9c958c;
}

.spread-control {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: #eadff7;
}

.spread-option {
  flex: 1;
  min-height: 76rpx;
  border-radius: 14rpx;
  color: #70685d;
  font-size: 30rpx;
  font-weight: 800;
}

.spread-option.active {
  background: #fffaf0;
  color: #26231f;
  box-shadow: 0 8rpx 24rpx rgba(64, 45, 24, 0.12);
}

.actions {
  display: flex;
  gap: 18rpx;
  margin: 36rpx 0;
}

.action-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 850;
}

.action-icon {
  font-size: 36rpx;
}

.draw-button {
  background: #5b3fa3;
  color: #fffaf0;
}

.interpret-button {
  background: #9b3f76;
  color: #fffaf0;
}

.interpret-button.disabled {
  background: #d5cabe;
  color: #81786f;
}

.cards-section {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  color: #26231f;
  font-size: 38rpx;
  font-weight: 900;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  align-items: stretch;
}

.cards-grid.single {
  grid-template-columns: minmax(0, 1fr);
}

.cards-grid.single .card {
  width: 100%;
  max-width: 620rpx;
  min-width: 0;
  margin: 0 auto;
}

.card {
  width: 100%;
  min-height: 0;
  padding: 20rpx 16rpx 22rpx;
  border: 2rpx solid #c9b0dd;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, transparent 0 25%, rgba(91, 63, 163, 0.16) 25% 28%, transparent 28%),
    #fbf7ff;
  box-sizing: border-box;
  text-align: center;
}

.card-face {
  display: block;
  width: 100%;
  height: 300rpx;
  margin: 16rpx auto 18rpx;
  border: 2rpx solid #8f6ac5;
  border-radius: 12rpx;
  background: #171311;
  box-shadow: 0 10rpx 18rpx rgba(38, 35, 31, 0.16);
}

.cards-grid.single .card-face {
  width: 58%;
  height: 630rpx;
  margin-top: 18rpx;
}

.card-face.reversed {
  transform: rotate(180deg);
}

.position {
  color: #a34231;
  font-size: 20rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.sigil {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 36rpx auto 22rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 50%;
  background: #fffaf0;
  color: #5b3fa3;
  font-size: 34rpx;
}

.card-name {
  display: block;
  min-height: 42rpx;
  color: #26231f;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.orientation {
  display: block;
  margin-top: 10rpx;
  color: #70685d;
  font-size: 22rpx;
  font-weight: 800;
  text-transform: capitalize;
}

.orientation.reversed {
  color: #a34231;
}

.message,
.reading,
.note {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
}

.message.error {
  border-color: rgba(163, 66, 49, 0.28);
  background: #fff0ea;
  color: #7a2e24;
  font-size: 28rpx;
  font-weight: 800;
}

.reading {
  line-height: 1.6;
}

.reading-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.source-pill {
  flex: 0 0 auto;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f1e9ff;
  color: #5b3fa3;
  font-size: 20rpx;
  font-weight: 850;
}

.reading-text {
  display: block;
  margin-top: 14rpx;
  color: #3d352e;
  font-size: 28rpx;
  line-height: 1.58;
}

.reading-cards {
  margin-top: 20rpx;
}

.reading-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #d8c5e8;
}

.reading-card-title,
.reading-label {
  display: block;
  margin-top: 24rpx;
  color: #5b3fa3;
  font-size: 24rpx;
  font-weight: 900;
}

.reading-meta,
.reading-caveat {
  display: block;
  margin-top: 8rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.45;
}

.reading-caveat {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #d8c5e8;
}

.note {
  color: #70685d;
  font-size: 24rpx;
  line-height: 1.55;
}

.provider-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.4;
}

.provider-status {
  color: #5b3fa3;
  font-weight: 850;
}

.provider-build {
  color: #9c958c;
}

.main-flow {
  min-height: 100vh;
}

.wheel-overlay {
  position: fixed;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% 16%, rgba(199, 139, 46, 0.2), transparent 24%),
    radial-gradient(circle at 52% 64%, rgba(91, 63, 163, 0.56), transparent 42%),
    #241047;
  color: #fffaf0;
}

.wheel-status {
  position: absolute;
  top: 52rpx;
  right: 36rpx;
  left: 36rpx;
  z-index: 5;
  text-align: center;
}

.wheel-eyebrow {
  display: block;
  color: #d9aa54;
  font-size: 22rpx;
  font-weight: 900;
}

.wheel-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.wheel-stage {
  position: absolute;
  top: 72rpx;
  right: 0;
  bottom: 104rpx;
  left: 0;
  overflow: hidden;
}

.wheel-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  white-space: nowrap;
}

.wheel-track {
  display: inline-flex;
  align-items: center;
  height: 100%;
  padding-top: 0;
  box-sizing: border-box;
}

.wheel-spacer {
  flex: 0 0 auto;
  height: 1rpx;
}

.wheel-spacer-start {
  width: 281rpx;
}

.wheel-spacer-end {
  width: 650rpx;
}

.wheel-card-slot {
  position: relative;
  z-index: 1;
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 330rpx;
  margin-right: -144rpx;
  opacity: 1;
  transition: filter 180ms ease, opacity 180ms ease;
}

.wheel-card-slot.active {
  z-index: 20;
  filter: drop-shadow(0 22rpx 30rpx rgba(0, 0, 0, 0.42)) drop-shadow(0 0 24rpx rgba(243, 221, 170, 0.88));
}

.wheel-card-slot.drawn {
  opacity: 0.18;
  filter: grayscale(1);
}

.wheel-card-slot.popped {
  z-index: 24;
  opacity: 1;
}

.wheel-card-slot.revealing {
  z-index: 28;
  opacity: 1;
  filter: drop-shadow(0 24rpx 40rpx rgba(0, 0, 0, 0.34)) drop-shadow(0 0 28rpx rgba(243, 221, 170, 0.82));
}

.wheel-card-arc {
  width: 100%;
  height: 100%;
  transform-origin: center 610rpx;
  transition: transform 120ms linear, opacity 120ms linear;
}

.wheel-card-shell {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 220ms ease;
}

.wheel-card-slot.active .wheel-card-shell {
  box-shadow: 0 0 0 3rpx rgba(243, 221, 170, 0.94);
}

.wheel-card-slot.popped .wheel-card-shell {
  transform: translateY(-26rpx) scale(1.06);
}

.wheel-card-slot.revealing .wheel-card-shell {
  transform: translateY(-34rpx) scale(1.1);
}

.wheel-card-back,
.wheel-card-face {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.wheel-card-face {
  border-radius: 12rpx;
}

.wheel-card-face.reversed {
  transform: rotate(180deg);
}

.wheel-copy {
  position: absolute;
  right: 36rpx;
  bottom: 64rpx;
  left: 36rpx;
  z-index: 7;
  min-height: 56rpx;
  color: #f3ddaa;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: center;
}
