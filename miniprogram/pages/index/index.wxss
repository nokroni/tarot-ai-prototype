.page {
  min-height: 100vh;
  padding: 52rpx 32rpx 72rpx;
  background:
    linear-gradient(90deg, rgba(91, 63, 163, 0.08) 1px, transparent 1px),
    linear-gradient(0deg, rgba(91, 63, 163, 0.06) 1px, transparent 1px),
    #f3edf8;
  background-size: 36rpx 36rpx;
  box-sizing: border-box;
}

.asset-gate {
  display: flex;
  min-height: calc(100vh - 124rpx);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 18rpx;
  text-align: center;
}

.asset-gate-mark {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(91, 63, 163, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.76);
  color: #a34231;
  font-size: 40rpx;
  font-weight: 900;
}

.asset-gate-title {
  color: #33283f;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.asset-gate-copy,
.asset-gate-count {
  color: #8f887f;
  font-size: 22rpx;
  font-weight: 700;
}

.asset-progress {
  width: 520rpx;
  max-width: 72vw;
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(91, 63, 163, 0.14);
}

.asset-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #a34231;
  transition: width 180ms ease;
}

.asset-retry {
  min-width: 168rpx;
  height: 58rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #5b3fa3;
  color: #fffaf0;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.hero-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.language-toggle {
  display: flex;
  width: 178rpx;
  height: 52rpx;
  flex: 0 0 178rpx;
  align-items: center;
  gap: 4rpx;
  padding: 5rpx;
  border: 2rpx solid rgba(91, 63, 163, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.72);
  box-sizing: border-box;
  overflow: hidden;
}

.language-option {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: transparent;
  color: #70685d;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.language-option.active {
  background: #5b3fa3;
  color: #fffaf0;
}

.resource-badge {
  display: block;
  max-width: 132rpx;
  padding: 8rpx 14rpx;
  border: 2rpx solid rgba(91, 63, 163, 0.2);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.74);
  box-sizing: border-box;
  color: #70685d;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.music-toggle {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  min-height: 0;
  min-width: 0;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 2rpx solid rgba(199, 139, 46, 0.72);
  border-radius: 999rpx;
  background: rgba(255, 250, 240, 0.72);
  box-sizing: border-box;
  color: #5b3fa3;
  line-height: 1;
  overflow: hidden;
}

.music-toggle::after {
  border: 0;
}

.music-toggle-note {
  font-size: 25rpx;
  font-weight: 900;
  transform: translateY(-1rpx);
}

.music-toggle.muted {
  opacity: 0.48;
}

.music-toggle.muted::before {
  position: absolute;
  top: 9rpx;
  left: 23rpx;
  width: 2rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #a34231;
  content: "";
  transform: rotate(42deg);
  transform-origin: center;
}

.eyebrow,
.label {
  display: block;
  color: #a34231;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #26231f;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 0.96;
}

.moon {
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, transparent 0 23rpx, #5b3fa3 24rpx 29rpx, transparent 30rpx);
}

.panel {
  margin-bottom: 28rpx;
}

.label {
  margin: 0 0 14rpx 36rpx;
  color: #70685d;
}

.label.compact {
  margin: 0 0 8rpx;
}

.question-input {
  width: 100%;
  height: 178rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
  color: #26231f;
  font-size: 32rpx;
  line-height: 1.42;
}

.decision-inputs {
  display: grid;
  gap: 14rpx;
}

.decision-input-card {
  padding: 18rpx 22rpx 20rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
}

.decision-question-card {
  border-color: rgba(199, 139, 46, 0.42);
}

.decision-option-label {
  display: block;
  margin-bottom: 10rpx;
  color: #a34231;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.question-input.decision-option-input {
  height: 126rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 30rpx;
}

.question-input.decision-question-input {
  height: 142rpx;
}

.placeholder {
  color: #9c958c;
}

.spread-control,
.reader-control {
  display: grid;
  gap: 8rpx;
  padding: 8rpx;
  overflow: hidden;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: #eadff7;
  box-sizing: border-box;
}

.spread-control {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.reader-control {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.spread-option,
.reader-option {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 76rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 14rpx;
  background: transparent;
  box-sizing: border-box;
  color: #70685d;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.18;
  overflow: hidden;
}

.spread-option::after,
.reader-option::after {
  border: 0;
}

.spread-option.active,
.reader-option.active {
  background: #fffaf0;
  color: #26231f;
  box-shadow: 0 8rpx 24rpx rgba(64, 45, 24, 0.12);
}

.spread-option {
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.spread-insight {
  display: block;
  margin: 14rpx 4rpx 0;
  color: #8f887f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
}

.reader-option {
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  line-height: 1.18;
}

.reader-name {
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin: 36rpx 0;
}

.action-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 850;
}

.action-icon {
  font-size: 36rpx;
}

.draw-button {
  background: #5b3fa3;
  color: #fffaf0;
}

.interpret-button {
  background: #9b3f76;
  color: #fffaf0;
}

.interpret-button.disabled {
  background: #d5cabe;
  color: #81786f;
}

.cards-section {
  margin-top: 34rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  color: #26231f;
  font-size: 38rpx;
  font-weight: 900;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  align-items: stretch;
}

.cards-grid.single {
  grid-template-columns: minmax(0, 1fr);
}

.cards-grid.pair {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.cards-grid.single .card {
  width: 100%;
  max-width: 620rpx;
  min-width: 0;
  margin: 0 auto;
}

.card {
  width: 100%;
  min-height: 0;
  padding: 20rpx 16rpx 22rpx;
  border: 2rpx solid #c9b0dd;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, transparent 0 25%, rgba(91, 63, 163, 0.16) 25% 28%, transparent 28%),
    #fbf7ff;
  box-sizing: border-box;
  text-align: center;
}

.card-face {
  display: block;
  width: 172rpx;
  max-width: 100%;
  height: 300rpx;
  margin: 16rpx auto 18rpx;
  border-radius: 10rpx;
  background: transparent;
  box-shadow: 0 10rpx 18rpx rgba(38, 35, 31, 0.16);
}

.cards-grid.pair .card-face {
  width: 218rpx;
  height: 380rpx;
}

.cards-grid.single .card-face {
  width: 58%;
  max-width: 360rpx;
  height: 630rpx;
  margin-top: 18rpx;
}

.card-face.reversed {
  transform: rotate(180deg);
}

.position {
  color: #a34231;
  font-size: 20rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.sigil {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 36rpx auto 22rpx;
  border: 2rpx solid #c78b2e;
  border-radius: 50%;
  background: #fffaf0;
  color: #5b3fa3;
  font-size: 34rpx;
}

.card-name {
  display: block;
  min-height: 42rpx;
  color: #26231f;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.2;
}

.orientation {
  display: block;
  margin-top: 10rpx;
  color: #70685d;
  font-size: 22rpx;
  font-weight: 800;
  text-transform: capitalize;
}

.orientation.reversed {
  color: #a34231;
}

.message,
.reading,
.note {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #d8c5e8;
  border-radius: 18rpx;
  background: rgba(255, 250, 240, 0.96);
  box-sizing: border-box;
}

.message.error {
  border-color: rgba(163, 66, 49, 0.28);
  background: #fff0ea;
  color: #7a2e24;
  font-size: 28rpx;
  font-weight: 800;
}

.reading {
  line-height: 1.6;
}

.reading-heading {
  display: flex;
  align-items: center;
}

.reading-text {
  display: block;
  margin-top: 14rpx;
  color: #3d352e;
  font-size: 28rpx;
  line-height: 1.58;
}

.reading-cards {
  margin-top: 20rpx;
}

.reading-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #d8c5e8;
}

.reading-card-title,
.reading-label {
  display: block;
  margin-top: 24rpx;
  color: #5b3fa3;
  font-size: 24rpx;
  font-weight: 900;
}

.reading-meta {
  display: block;
  margin-top: 8rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.45;
}

.note {
  color: #70685d;
  font-size: 24rpx;
  line-height: 1.55;
}

.provider-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  color: #70685d;
  font-size: 22rpx;
  line-height: 1.4;
}

.provider-status {
  color: #5b3fa3;
  font-weight: 850;
}

.provider-build {
  color: #9c958c;
}

.main-flow {
  min-height: 100vh;
  transition:
    opacity 720ms ease,
    transform 840ms cubic-bezier(0.2, 0.78, 0.18, 1),
    filter 840ms ease;
}

.main-flow-wheel-open {
  opacity: 0.72;
  filter: blur(2rpx);
  pointer-events: none;
  transform: scale(0.985);
}

.wheel-overlay {
  position: fixed;
  inset: 0;
  overflow: hidden;
  -webkit-clip-path: circle(0% at 50% 56%);
  clip-path: circle(0% at 50% 56%);
  background:
    radial-gradient(circle at 50% 16%, rgba(199, 139, 46, 0.2), transparent 24%),
    radial-gradient(circle at 52% 64%, rgba(91, 63, 163, 0.56), transparent 42%),
    #241047;
  color: #fffaf0;
  animation: wheel-aperture-open 920ms cubic-bezier(0.16, 0.82, 0.18, 1) forwards;
  will-change: clip-path, opacity;
}

.wheel-overlay::before {
  position: absolute;
  inset: -16rpx;
  z-index: 0;
  content: "";
  background:
    radial-gradient(circle at 50% 56%, rgba(255, 250, 240, 0.12), transparent 21%),
    radial-gradient(circle at 50% 56%, transparent 0 32%, rgba(20, 9, 39, 0.26) 54%, rgba(20, 9, 39, 0.52) 100%);
  pointer-events: none;
}

.wheel-aperture-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  width: 180rpx;
  height: 180rpx;
  border: 2rpx solid rgba(243, 221, 170, 0.62);
  border-radius: 50%;
  box-shadow:
    0 0 42rpx rgba(243, 221, 170, 0.32),
    inset 0 0 32rpx rgba(243, 221, 170, 0.18);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -50%) scale(0.24);
  animation: wheel-aperture-ring-open 1120ms cubic-bezier(0.12, 0.78, 0.16, 1) forwards;
}

.wheel-motion-closing {
  pointer-events: none;
  animation: wheel-aperture-close 660ms cubic-bezier(0.3, 0, 0.2, 1) forwards;
}

.wheel-motion-closing .wheel-aperture-ring {
  animation: wheel-aperture-ring-close 660ms cubic-bezier(0.3, 0, 0.2, 1) forwards;
}

.wheel-status {
  position: absolute;
  top: 52rpx;
  right: 36rpx;
  left: 36rpx;
  z-index: 5;
  text-align: center;
  animation: wheel-content-enter 840ms cubic-bezier(0.18, 0.82, 0.16, 1) 120ms both;
}

.wheel-eyebrow {
  display: block;
  color: #d9aa54;
  font-size: 22rpx;
  font-weight: 900;
}

.wheel-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.wheel-stage {
  position: absolute;
  top: 20rpx;
  right: 0;
  bottom: 104rpx;
  left: 0;
  z-index: 2;
  overflow: hidden;
  animation: wheel-content-enter 880ms cubic-bezier(0.18, 0.82, 0.16, 1) 120ms both;
}

.wheel-scroll {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  white-space: nowrap;
}

.wheel-motion-stack .wheel-scroll,
.wheel-motion-spreading .wheel-scroll,
.wheel-motion-closing .wheel-scroll {
  pointer-events: none;
}

.wheel-track {
  display: inline-flex;
  align-items: center;
  height: 100%;
  padding-top: 0;
  box-sizing: border-box;
}

.wheel-spacer {
  flex: 0 0 auto;
  height: 1rpx;
}

.wheel-spacer-start {
  width: 281rpx;
}

.wheel-spacer-end {
  width: 650rpx;
}

.wheel-card-slot {
  position: relative;
  z-index: 1;
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 330rpx;
  margin-right: -156rpx;
  opacity: 1;
  transition:
    filter 180ms ease,
    opacity 180ms ease;
}

.wheel-card-slot.active {
  z-index: 20;
  filter: drop-shadow(0 22rpx 30rpx rgba(0, 0, 0, 0.42)) drop-shadow(0 0 24rpx rgba(243, 221, 170, 0.88));
}

.wheel-card-slot.drawn {
  opacity: 0.18;
  filter: grayscale(1);
}

.wheel-card-slot.popped {
  z-index: 24;
  opacity: 1;
}

.wheel-card-arc {
  width: 100%;
  height: 100%;
  transform-origin: center 760rpx;
  transition: transform 120ms linear, opacity 120ms linear;
  will-change: transform, opacity;
}

.wheel-motion-stack .wheel-card-arc {
  transition: none;
}

.wheel-motion-spreading .wheel-card-arc {
  transition:
    transform 1120ms cubic-bezier(0.18, 0.82, 0.22, 1),
    opacity 720ms ease;
}

.wheel-motion-closing .wheel-card-arc {
  transition:
    transform 520ms cubic-bezier(0.28, 0, 0.18, 1),
    opacity 300ms ease;
}

.wheel-motion-closing .wheel-stage,
.wheel-motion-closing .wheel-status,
.wheel-motion-closing .wheel-copy {
  animation: wheel-content-exit 540ms cubic-bezier(0.3, 0, 0.2, 1) forwards;
}

.wheel-card-shell {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 14rpx;
  transition:
    transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
    filter 220ms ease;
}

.wheel-card-slot.active .wheel-card-shell {
  box-shadow: 0 0 0 3rpx rgba(243, 221, 170, 0.94);
}

.wheel-card-slot.popped .wheel-card-shell {
  transform: translateY(-26rpx) scale(1.06);
}

.wheel-card-back,
.wheel-card-face {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
}

.wheel-card-face {
  border-radius: 12rpx;
}

.wheel-card-face.reversed {
  transform: rotate(180deg);
}

.wheel-flight-card {
  position: absolute;
  top: 132rpx;
  left: 38rpx;
  z-index: 6;
  width: 188rpx;
  height: 330rpx;
  perspective: 1180rpx;
  pointer-events: none;
}

.wheel-flight-card-plane {
  width: 100%;
  height: 100%;
  transform-origin: center;
  animation: wheel-card-pop-move 820ms cubic-bezier(0.08, 0.72, 0.12, 1) forwards;
}

.wheel-flight-card-draw {
  width: 100%;
  height: 100%;
  transform-origin: center;
}

.wheel-flight-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
}

.wheel-flight-face {
  position: absolute;
  inset: 0;
}

.wheel-flight-back {
  opacity: 1;
  animation: wheel-card-draw-back-flip 300ms cubic-bezier(0.22, 0.72, 0.2, 1) 820ms forwards;
  backface-visibility: hidden;
}

.wheel-flight-front {
  animation: wheel-card-draw-front-flip 300ms cubic-bezier(0.22, 0.72, 0.2, 1) 820ms forwards;
  backface-visibility: hidden;
  transform: rotateX(180deg);
}

.wheel-flight-sigil {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(243, 221, 170, 0.72);
  border-radius: 14rpx;
  background: #171311;
  box-sizing: border-box;
  color: #f3ddaa;
  font-size: 64rpx;
}

@keyframes wheel-card-pop-move {
  0% {
    opacity: 1;
    transform: translate(245rpx, 360rpx) rotate(-4deg) scale(1.04);
  }

  12% {
    opacity: 1;
    transform: translate(215rpx, 316rpx) rotate(-4deg) scale(1.14);
  }

  100% {
    opacity: 1;
    transform: translate(0, 0) rotate(0deg) scale(0.78);
  }
}

@keyframes wheel-card-draw-back-flip {
  0% {
    transform: rotateX(0deg);
  }

  100% {
    transform: rotateX(180deg);
  }
}

@keyframes wheel-card-draw-front-flip {
  0% {
    transform: rotateX(180deg);
  }

  100% {
    transform: rotateX(360deg);
  }
}

.wheel-copy {
  position: absolute;
  right: 36rpx;
  bottom: 64rpx;
  left: 36rpx;
  z-index: 7;
  min-height: 56rpx;
  color: #f3ddaa;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: center;
  animation: wheel-content-enter 840ms cubic-bezier(0.18, 0.82, 0.16, 1) 160ms both;
}

@keyframes wheel-aperture-open {
  0% {
    opacity: 0;
    -webkit-clip-path: circle(0% at 50% 56%);
    clip-path: circle(0% at 50% 56%);
  }

  18% {
    opacity: 1;
  }

  100% {
    opacity: 1;
    -webkit-clip-path: circle(142% at 50% 56%);
    clip-path: circle(142% at 50% 56%);
  }
}

@keyframes wheel-aperture-close {
  0% {
    opacity: 1;
    -webkit-clip-path: circle(142% at 50% 56%);
    clip-path: circle(142% at 50% 56%);
  }

  78% {
    opacity: 1;
  }

  100% {
    opacity: 0.96;
    -webkit-clip-path: circle(0% at 50% 56%);
    clip-path: circle(0% at 50% 56%);
  }
}

@keyframes wheel-aperture-ring-open {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.18);
  }

  32% {
    opacity: 0.82;
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(6.2);
  }
}

@keyframes wheel-aperture-ring-close {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(6.2);
  }

  38% {
    opacity: 0.7;
  }

  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.2);
  }
}

@keyframes wheel-content-enter {
  0% {
    opacity: 0;
    transform: scale(0.975);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes wheel-content-exit {
  0% {
    opacity: 1;
    transform: scale(1);
  }

  100% {
    opacity: 0;
    transform: scale(0.965);
  }
}
