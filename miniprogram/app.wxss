page {
  min-height: 100vh;
  background: #f5f0e6;
  color: #26231f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}
